{
  "name": "assets-platform",
  "private": true,
  "version": "0.0.8",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@assets/web...",
    "dev:backend": "turbo run dev --filter=@assets/backend...",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@assets/web...",
    "build:backend": "turbo run build --filter=@assets/backend...",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
    "storybook": "cd apps/web && pnpm storybook",
    "build-storybook": "cd apps/web && pnpm build-storybook",
    "tauri-dev": "cd apps/backend && pnpm dev",
    "tauri-build": "cd apps/backend && pnpm build",
    "setup": "node script/install-deps.cjs"
  },
  "dependencies": {},
  "devDependencies": {
    "turbo": "^2.10.5",
    "prettier": "^3.6.2"
  },
  "packageManager": "pnpm@11.13.0+sha512.88d94724d8f2e6c186744a5584c6e59ecac869ec7ba15e9cb4cd628e8dc7066820b2481d8ee3b51ea8da323a7378068aa58c556a3720d32b7c20a051d088363a"
}