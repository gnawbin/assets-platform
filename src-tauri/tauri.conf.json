{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "资产管理平台",
  "version": "0.0.7",
  "identifier": "com.it.assets",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1480",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "资产管理平台",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
