# doc-parser 配置示例
# 复制此文件为 .env 后修改

# 服务端口
PARSER_HOST=127.0.0.1
PARSER_PORT=8321

# VLM 模式: ollama (本地) / cloud (云端 API 经 Rust 中转)
VLM_MODE=ollama

# Ollama 配置（ollama 模式用）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VLM_MODEL=llava

# Rust 后端 LLM 网关地址（cloud 模式用）
RUST_GATEWAY_URL=http://127.0.0.1:1420

# Whisper 模型: tiny / base / small / medium / large
WHISPER_MODEL=base

# OCR 语言
OCR_LANGUAGE=chi_sim+eng

# 视频抽帧间隔（秒）
FRAME_INTERVAL_SEC=30