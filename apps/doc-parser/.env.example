# doc-parser 配置示例
# 复制此文件为 .env 后修改

# 服务端口
PARSER_HOST=127.0.0.1
PARSER_PORT=8321

# ─── 认证 ───────────────────────────────────────────
# 动态密钥：由 Tauri 启动 doc-parser 时通过环境变量 DOC_PARSER_TOKEN 注入
# ⚠️ 生产环境不要在这里写死（写死会退化为静态密钥方案）
# DOC_PARSER_TOKEN=

# Whisper 模型: tiny / base / small / medium / large
WHISPER_MODEL=base

# OCR 语言
OCR_LANGUAGE=chi_sim+eng

# 视频抽帧间隔（秒）
FRAME_INTERVAL_SEC=30