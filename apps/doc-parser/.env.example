# doc-parser 配置示例
# 复制此文件为 .env 后修改

# 服务端口
PARSER_HOST=127.0.0.1
PARSER_PORT=8321

# ─── 认证 ───────────────────────────────────────────
# 本文件同时服务于三种部署模式，token 语义不同，请按下表理解：
#
#   A 内嵌自启动（后端自己拉起 uvicorn，DOC_PARSER_ENABLED=true）
#       → token 由后端进程启动时生成随机 UUID 并注入子进程，
#         本文件**不要**设置 DOC_PARSER_TOKEN（设置也无效，会被注入值覆盖）。
#
#   B 独立进程（systemd）/ C 独立容器（Docker） —— 后端只做客户端
#       → 下例中的静态 token **必须设置**，且需与后端 [doc_parser] token 完全一致：
#         # 生成
#         python -c "import uuid; print(uuid.uuid4())"     # 或 openssl rand -hex 32
#         # 写入本文件（权限 600）：
#         DOC_PARSER_TOKEN=<生成的值>
#         注：独立部署下静态共享密钥是唯一可行的鉴权方式，
#             "不要写死" 的告诫仅适用于模式 A。
#
# DOC_PARSER_TOKEN=
#
# 仅本机调试时可临时允许空 token 启动；生产必须为 0 或不设置
# （该开关由 B0-4b 实现：空 token 默认直接拒绝启动，容器内 PARSER_HOST=0.0.0.0 时强制拒绝）
DOC_PARSER_ALLOW_NO_TOKEN=0
#
# ⚠️ 容器内必须 PARSER_HOST=0.0.0.0 才能被宿主机访问，此时 token 必须非空；
#    端口发布务必用 -p 127.0.0.1:8321:8321，不要用 -p 8321:8321。
#    完整部署步骤见 docs/doc-parser 独立部署指南.md


# Whisper 模型: tiny / base / small / medium / large
WHISPER_MODEL=base

# OCR 语言
OCR_LANGUAGE=chi_sim+eng

# 视频抽帧间隔（秒）
FRAME_INTERVAL_SEC=30

# ─── Embedding ───────────────────────────────────────
# 与 Rust 端向量维度保持一致（bge-small-zh = 512，bge-base-zh = 768）
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# EMBEDDING_DIM=512
# HF 下载端点（国内网络建议 https://hf-mirror.com，留空走官方）
# HF_ENDPOINT=https://hf-mirror.com

# ─── 文本切片 ────────────────────────────────────────
# 时间窗口切分（秒），与 FRAME_INTERVAL_SEC 对齐
# CHUNK_WINDOW_SEC=30
# 单个切片最大字符数，超长二次切分阈值
# CHUNK_MAX_CHARS=500

# ─── SurrealDB（向量记忆存储）────────────────────────
# 远程分布式：ws://127.0.0.1:8000
# 嵌入式：file://./data/surrealdb 或 mem://（内存，测试用）
# SURREALDB_URL=file://./data/surrealdb
# SURREALDB_USER=admin
# SURREALDB_PASS=Admin@123456
# SURREALDB_NS=assets
# SURREALDB_DB=knowledge
# SURREALDB_TABLE=video_knowledge

# ─── LLM（/ask RAG 问答生成）─────────────────────────
# VLM_MODE=ollama   # ollama / cloud
# OLLAMA_BASE_URL=http://localhost:11434