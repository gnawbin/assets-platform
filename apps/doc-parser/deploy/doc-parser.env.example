# doc-parser systemd 部署环境文件模板
# 安装到 /etc/doc-parser/doc-parser.env，权限 600（含密钥）
#   sudo install -o root -g root -m 600 deploy/doc-parser.env.example /etc/doc-parser/doc-parser.env

# ─── 服务 ─────────────────────────────────────────────
# systemd 模式：仅本机可访问（Docker 模式改为 0.0.0.0，见 Dockerfile）
PARSER_HOST=127.0.0.1
PARSER_PORT=8321

# ─── 认证（独立部署必填）───────────────────────────────
# 生成：python -c "import uuid; print(uuid.uuid4())"
# 或：  openssl rand -hex 32
# 该值必须与后端 apps/backend/.env.toml 的 [doc_parser] token 完全一致
DOC_PARSER_TOKEN=CHANGE_ME

# 仅本机调试时可临时置 1 允许空 token 启动；生产环境必须为 0 或不设置
DOC_PARSER_ALLOW_NO_TOKEN=0

# ─── 模型与解析 ───────────────────────────────────────
WHISPER_MODEL=base
OCR_LANGUAGE=chi_sim+eng
FRAME_INTERVAL_SEC=30
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
# 国内网络建议 https://hf-mirror.com，留空走官方
HF_ENDPOINT=https://hf-mirror.com
CHUNK_WINDOW_SEC=30
CHUNK_MAX_CHARS=500

# ─── 向量存储（SurrealDB）─────────────────────────────
# 独立部署推荐连远程实例；嵌入式 file:// 需保证 CWD 可写（systemd 下为 WorkingDirectory）
SURREALDB_URL=ws://127.0.0.1:8000
SURREALDB_USER=admin
SURREALDB_PASS=CHANGE_ME
SURREALDB_NS=assets
SURREALDB_DB=knowledge
SURREALDB_TABLE=video_knowledge

# ─── LLM / VLM（/ask RAG 生成、工作流节点）────────────
VLM_MODE=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
