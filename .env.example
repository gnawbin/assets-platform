# PostgreSQL 数据库配置
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=assets_plateform
PG_USERNAME=postgres
PG_PASSWORD=123456

# ======================== OpenTelemetry 配置 ========================

# 后端 OTel 配置（Rust tracing + opentelemetry）
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=assets-platform

# 前端 OTel 配置（Next.js @opentelemetry/*）
NEXT_PUBLIC_OTEL_ENABLED=true
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
NEXT_PUBLIC_OTEL_SERVICE_NAME=assets-platform
