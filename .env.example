# ======================== API 适配器配置 ========================

# API 适配器类型（构建时默认值，运行时自动检测 Tauri 环境）
# - tauri：通过 Tauri invoke 调用 Rust 后端（桌面版，默认）
# - http：通过 HTTP fetch 调用 REST API（Web 版，需后端 HTTP 服务支持）
# 不设置时，自动检测：Tauri 环境使用 tauri，其他环境默认使用 tauri
# NEXT_PUBLIC_API_ADAPTER=tauri


# HTTP 适配器的 API 基础 URL（仅 NEXT_PUBLIC_API_ADAPTER=http 时生效）
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# ======================== PostgreSQL 数据库配置 ========================
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=assets_plateform
PG_USERNAME=postgres
PG_PASSWORD=123456

# ======================== OpenTelemetry 配置 ========================

# 后端 OTel 配置（Rust tracing + opentelemetry）
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=assets-platform

# 前端 OTel 配置（Next.js @opentelemetry/*）
NEXT_PUBLIC_OTEL_ENABLED=true
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
NEXT_PUBLIC_OTEL_SERVICE_NAME=assets-platform


